{
  "name": "oxlint-flat-config",
  "version": "0.2.0",
  "description": "Compose Oxlint configs from ESLint-style flat config arrays.",
  "keywords": [
    "config",
    "eslint",
    "eslint-flat-config",
    "flat-config",
    "lint",
    "linter",
    "oxc",
    "oxlint"
  ],
  "homepage": "https://github.com/liangmiQwQ/oxlint-flat-config#readme",
  "bugs": {
    "url": "https://github.com/liangmiQwQ/oxlint-flat-config/issues"
  },
  "license": "MIT",
  "author": "Liang Mi <hi@liangmi.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangmiQwQ/oxlint-flat-config.git",
    "directory": "packages/oxlint-flat-config"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run cpack",
    "check": "vp run ccheck",
    "dev": "vp pack --watch",
    "prepack": "vp run build",
    "test": "vp run ctest"
  },
  "dependencies": {
    "get-oxlint-rules": "catalog:",
    "glob-distribute": "catalog:"
  },
  "devDependencies": {
    "oxlint": "catalog:"
  },
  "peerDependencies": {
    "oxlint": ">=1.85.0"
  }
}
