{
  "name": "@oxlint-flat-config/composer",
  "version": "0.3.0",
  "description": "Change shared Oxlint flat configs with a chainable API.",
  "keywords": [
    "composer",
    "config",
    "flat-config",
    "lint",
    "linter",
    "oxc",
    "oxlint",
    "preset"
  ],
  "homepage": "https://github.com/liangmiQwQ/oxlint-flat-config#readme",
  "bugs": {
    "url": "https://github.com/liangmiQwQ/oxlint-flat-config/issues"
  },
  "license": "MIT",
  "author": "Liang Mi <hi@liangmi.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangmiQwQ/oxlint-flat-config.git",
    "directory": "packages/composer"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./vite-plus": "./dist/vite-plus.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp run cpack",
    "check": "vp run ccheck",
    "dev": "vp pack --watch",
    "prepack": "vp run build",
    "test": "vp run ctest"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "oxlint-flat-config": "workspace:^",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "oxlint": ">=1.85.0",
    "oxlint-flat-config": "^0.3.0",
    "vite-plus": ">=1.0.0-rc.1"
  },
  "peerDependenciesMeta": {
    "oxlint": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  }
}
